AI_TRNS_API_URL=http://127.0.0.1:8766
AI_TRNS_WORKER_KEY=change-me-too
AI_TRNS_MODELS_DIR=/home/ai-trns/models
AI_TRNS_WORK_DIR=/home/ai-trns/work
# the same directory for the workers of one host: a media URL is converted once (ai_trns.worker.wavcache)
AI_TRNS_AUDIO_CACHE_DIR=/home/ai-trns/audio-cache
AI_TRNS_BATCH_SIZE=8
AI_TRNS_IDLE_UNLOAD_S=300
# Speaker diarization (/diarize) on this GPU too: pip install -r requirements-diarize.txt, a HuggingFace token
# with pyannote/speaker-diarization-community-1 accepted, built-in voice samples in <speakers>/<Name>/*.mp3
#AI_TRNS_WORKER_ENGINES=transcribe,diarize
#AI_TRNS_SPEAKERS_DIR=/home/ai-trns/models/speakers
#HF_TOKEN=
# Transcribe Hebrew media URLs through whisper_trainer's job service instead of the model here; uploads and
# other languages run on models/<lang> (no models here: set AI_TRNS_TRANSCRIBE_UPLOADS=0 on the API, the default)
#AI_TRNS_STT_URL=http://10.66.1.53:8765
