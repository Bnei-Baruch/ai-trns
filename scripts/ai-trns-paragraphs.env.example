# Paragraphing service (ai-trns-paragraphs.service) on the host with mdb-lora (`stt`); the diarize worker calls it
# with AI_TRNS_PARAGRAPHS_URL / AI_TRNS_PARAGRAPHS_KEY. Code: ai_trns/__init__.py + ai_trns/paragraphs/ in WorkingDirectory
MDB_LORA_DIR=/home/mdb-lora
PARAGRAPHS_PORT=8766
PARAGRAPHS_IDLE_UNLOAD_S=300
PARAGRAPHS_KEY=change-me
