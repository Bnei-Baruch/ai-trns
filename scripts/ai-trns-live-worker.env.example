# Live worker (ai-trns-live-worker.service): its own process, because a live job holds the worker for
# the whole stream; it loads the model here even where the transcribe worker uses AI_TRNS_STT_URL
AI_TRNS_API_URL=http://127.0.0.1:8766
AI_TRNS_WORKER_KEY=
AI_TRNS_WORKER_ID=ai-tools-live0
AI_TRNS_WORKER_ENGINES=live
AI_TRNS_MODELS_DIR=/home/ai-trns/models
AI_TRNS_WORK_DIR=/home/ai-trns/work-live
AI_TRNS_IDLE_UNLOAD_S=300
