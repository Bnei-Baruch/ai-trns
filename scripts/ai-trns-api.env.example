AI_TRNS_HOST=0.0.0.0
AI_TRNS_PORT=8766
# Users: Keycloak access tokens (Authorization: Bearer ...)
AI_TRNS_OIDC_ISSUER=https://accounts.kab.info/auth/realms/main
AI_TRNS_OIDC_CLIENTS=ai-tools
AI_TRNS_OIDC_ROLE=bb_user
AI_TRNS_ADMIN_ROLE=
# Services: name:key,name:key (X-API-Key or Authorization: Bearer)
AI_TRNS_API_KEYS=admin:change-me
AI_TRNS_WORKER_KEY=change-me-too
AI_TRNS_CORS_ORIGINS=https://ai-tools.kab.info
AI_TRNS_JOBS_DIR=/home/ai-trns/jobs
AI_TRNS_ALLOWED_URL_HOSTS=cdn.kabbalahmedia.info,.kab.tv
AI_TRNS_JOB_TTL_HOURS=72
# STT review (/review/*): sets, lessons and results; copy stt-api's data/review here to keep them
AI_TRNS_REVIEW_DIR=/home/ai-trns/review
AI_TRNS_REVIEW_MODEL=
# Uploaded audio for transcribe / tadiff / docdiff; off while workers use whisper_trainer's service
# (AI_TRNS_STT_URL), which takes media URLs only
AI_TRNS_TRANSCRIBE_UPLOADS=0
# Live text into a Google Doc the server creates for each live job, on one account (chmod 600); empty = off.
# A service account's key (it has no Drive of its own: give a folder in a shared drive it is a member of),
# or an authorized_user JSON (client_id, client_secret, refresh_token with the documents + drive scopes)
#AI_TRNS_GOOGLE_CREDENTIALS=/home/ai-trns/google-credentials.json
#AI_TRNS_GOOGLE_FOLDER=<Drive folder id>
# Anyone with the link gets this role on the doc (reader / commenter / writer); empty: the folder's sharing
#AI_TRNS_GOOGLE_DOC_ROLE=writer
