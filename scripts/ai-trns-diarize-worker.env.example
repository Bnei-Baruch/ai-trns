# Diarize worker (ai-trns-diarize-worker.service) in its own venv, so torch stays out of the transcribe/live env:
#   python3 -m venv /home/ai-trns/env-diarize
#   env-diarize/bin/pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu126  # driver 535
#   env-diarize/bin/pip install -r requirements-diarize.txt -r requirements-api.txt
AI_TRNS_PYTHON=/home/ai-trns/env-diarize/bin/python
AI_TRNS_API_URL=http://127.0.0.1:8766
AI_TRNS_WORKER_KEY=change-me-too
AI_TRNS_WORKER_ID=ai-tools-diarize0
AI_TRNS_WORKER_ENGINES=diarize
AI_TRNS_MODELS_DIR=/home/ai-trns/models
# built-in voice samples: <dir>/<Name>/*.mp3 (Rav -> רב, see ai_trns/diarize/labels.py)
AI_TRNS_SPEAKERS_DIR=/home/ai-trns/models/speakers
AI_TRNS_WORK_DIR=/home/ai-trns/work-diarize
AI_TRNS_IDLE_UNLOAD_S=300
HF_HOME=/home/ai-trns/.cache/huggingface
# HuggingFace token with pyannote/speaker-diarization-community-1 accepted
HF_TOKEN=
